{
  "editor.formatOnSave": true,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.associations": {
    "*.cpp": "cpp",
    "iostream": "cpp",
    "vector": "cpp"
  },
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--completion-style=detailed"
  ],
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format"
  }
}
